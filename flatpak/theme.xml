<theme>

    <formatVersion>7</formatVersion>
    <include>./../theme.xml</include>

	<!-- generated by tools/gen-systems.py (CleanShelf) -->

	<view name="system">

		<text name="systemName" extra="true">
			<text>Flatpak</text>
			<pos>0.03 0.025</pos>
			<size>0.42 0.3</size>
			<backgroundColor>22222200</backgroundColor>
			<fontPath>./../_inc/fonts/FiraSans-Black.ttf</fontPath>
			<fontSize>0.116</fontSize>
			<lineSpacing>0.69</lineSpacing>
			<alignment>left</alignment>
		</text>

		<text name="systemYear" extra="true">
			<text>Linux apps</text>
			<pos>0.03 0.33</pos>
			<backgroundColor>22222200</backgroundColor>
			<fontPath>./../_inc/fonts/FiraSans-Bold.ttf</fontPath>
			<fontSize>0.035</fontSize>
			<lineSpacing>0.69</lineSpacing>
			<alignment>left</alignment>
		</text>

		<text name="systemtxt" extra="true">
			<text>Desktop applications installed from Flathub. Batocera lists each installed Flatpak so it can be started from the controller like a game.</text>
			<pos>0.03 0.39</pos>
			<size>0.42 0.3</size>
			<backgroundColor>22222200</backgroundColor>
			<fontPath>./../_inc/fonts/FiraSans-Regular.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<lineSpacing>0.89</lineSpacing>
			<alignment>left</alignment>
		</text>

		<image name="background_art" extra="true">
			<color>4A86CF</color>
			<colorEnd>305786</colorEnd>
		</image>

	</view>

	<view name="detailed">

		<image name="logo">
			<path>./logo2.png</path>
			<pos>0.92 0.048</pos>
			<maxSize>0.1 0.045</maxSize>
			<origin>0.5 0.5</origin>
		</image>

		<image name="gamelistbg" extra="true">
			<color>4A86CF</color>
			<colorEnd>305786</colorEnd>
		</image>

		<image name="syscolorbar" extra="true">
			<color>4A86CF</color>
		</image>

	</view>

	<view name="grid">

		<image name="logo">
			<path>./logo2.png</path>
			<pos>0.92 0.048</pos>
			<maxSize>0.1 0.045</maxSize>
			<origin>0.5 0.5</origin>
		</image>

		<image name="gamelistbg" extra="true">
			<color>4A86CF</color>
			<colorEnd>305786</colorEnd>
		</image>

	</view>

	<view name="basic">

		<image name="basicgamelistbg" extra="true">
			<color>4A86CF</color>
			<colorEnd>305786</colorEnd>
		</image>

	</view>

	<!-- dark mode draws the list text black: lighter tints of the colour keep it readable -->

	<view name="basic" ifSubset="darkmode:On">

		<image name="basicgamelistbg" extra="true">
			<color>6598D6</color>
			<colorEnd>839AB6</colorEnd>
		</image>

	</view>

	<view name="detailed" ifSubset="darkmode:On">

		<image name="gamelistbg" extra="true">
			<color>6598D6</color>
			<colorEnd>839AB6</colorEnd>
		</image>

		<image name="syscolorbar" extra="true">
			<color>6598D6</color>
		</image>

	</view>

	<view name="grid" ifSubset="darkmode:On">

		<image name="gamelistbg" extra="true">
			<color>6598D6</color>
			<colorEnd>839AB6</colorEnd>
		</image>

	</view>

</theme>
